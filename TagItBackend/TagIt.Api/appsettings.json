{
  "ConnectionStrings": {
    "Sql": "Server=localhost;Database=TagItDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "*",
      "ClientSecret": "*"
    },
    "Jwt": {
      "SecretKey": "your-super-secret-jwt-key-that-is-at-least-32-characters-long",
      "Issuer": "tagit-backend",
      "Audience": "tagit-frontend",
      "ExpirationHours": 24
    },
    "Gemini": {
      "ApiKey": "*"
    }
  }
}
